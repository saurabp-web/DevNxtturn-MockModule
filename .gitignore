# ==============================================================================
# --- .gitignore: Global Project Ignore List ---
# ==============================================================================

# --- Virtual Environments (The "Broad" Catch) ---
venv/
.venv/
env/

# --- Node & Frontend Junk ---
node_modules/
dist/
.npm/
.vite/
.nuxt/
*.tsbuildinfo

# --- Python System & Cache Junk ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.log
pip-log.txt
pip-delete-this-directory.txt

# --- IDE & OS Files ---
.idea/
.vscode/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Secrets (CRITICAL) ---
.env
.env.*
!.env.example

# --- Local Data & Media ---
mediafiles/
seed_media/
*.sqlite3
Loopline/seeded_users.txt

# --- Local SSL Certificates ---
Loopline/cert.crt
Loopline/cert.key