# ==============================================================================
# --- .env.example: FOR NEW DEVELOPERS ---
# Copy this file to '.env' and fill in your local settings.
# This file is version-controlled and contains NO SECRETS.
# ==============================================================================

# --- SERVER & FRONTEND URLs ---
# IMPORTANT: Replace CHANGE_TO_YOUR_IP with YOUR laptop's IPv4 Address.
#            Run 'ipconfig' in CMD to find it (e.g., 192.168.1.50).
ALLOWED_HOSTS=localhost,127.0.0.1,CHANGE_TO_YOUR_IP,CHANGE_TO_YOUR_IP.nip.io
FRONTEND_URL=https://CHANGE_TO_YOUR_IP.nip.io:5173

# --- VITE FRONTEND API Endpoints (Used by your Vue.js application) ---
# IMPORTANT: Replace CHANGE_TO_YOUR_IP with YOUR laptop's IPv4 Address.
VITE_API_BASE_URL=https://CHANGE_TO_YOUR_IP.nip.io:8000/api/
VITE_WS_BASE_URL=wss://CHANGE_TO_YOUR_IP.nip.io:8000/ws/

# --- CYPRESS TEST CONFIGURATION ---
# IMPORTANT: Replace CHANGE_TO_YOUR_IP with YOUR laptop's IPv4 Address.
CYPRESS_BASE_URL=https://CHANGE_TO_YOUR_IP.nip.io:5173

# --- DJANGO CORE SETTINGS ---
# A dummy key for local development. Google Cloud will provide a real one.
SECRET_KEY=a-dummy-secret-key-for-local-development-only-do-not-use-in-prod

# --- DATABASE CONFIGURATION (PostgreSQL - Used by Docker 'db' service) ---
# This password is for the local Docker database.
# For a fresh install, the default 'devpass' from docker-compose.yml will be used.
DB_NAME=community_portal
DB_USER=postgres
DB_PASSWORD=devpass # Or your specific local Docker DB password
DB_HOST=db
DB_PORT=5432

# --- CACHE & REAL-TIME CONFIGURATION (Redis - Used by Docker 'redis' service) ---
REDIS_URL=redis://redis:6379/0

# --- EMAIL SERVICE INTEGRATION (Brevo) ---
# Set EMAIL_MODE to 'console' to print emails to your terminal.
# Set EMAIL_MODE to 'brevo' to send real emails via Brevo (requires API key).
EMAIL_MODE=console
# EMAIL_MODE=brevo
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE # Get this securely from the project owner

# --- SOCIAL AUTHENTICATION (Google) ---
# These keys are from the Google Cloud Console.
# IMPORTANT: Ensure your Authorized Redirect URIs in Google Console are updated to your current IP.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE # Get this securely from the project owner
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE # Get this securely from the project owner